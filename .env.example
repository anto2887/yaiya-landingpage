# Copy to .env.local for local development. Never commit real values.
# The site must run with every tracking value empty.

# Postgres connection string. On Railway, reference the Postgres service's URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yaiya

# Canonical site URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog. Leave the key empty to turn PostHog off.
NEXT_PUBLIC_POSTHOG_KEY=
# The proxy path on this site (see next.config.mjs).
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Your PostHog region hosts. Check PostHog's docs for the current values.
POSTHOG_UPSTREAM_HOST=https://us.i.posthog.com
POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

# Meta pixel. Leave empty to turn the pixel off.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API token. Leave empty to turn server events off.
META_CAPI_TOKEN=

# Label saved with each signup.
LANDING_VARIANT=v1

# Long random string used to hash IP addresses in the rate limiter.
IP_HASH_SALT=change-me
